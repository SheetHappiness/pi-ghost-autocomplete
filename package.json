{
  "name": "pi-ghost-autocomplete",
  "version": "0.1.0",
  "description": "Local SmolLM2 ghost text autocomplete for Pi",
  "repository": {
    "type": "git",
    "url": "https://github.com/SheetHappiness/pi-ghost-autocomplete.git"
  },
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./src/pi-ghost-autocomplete.ts"
    ]
  },
  "files": [
    "src",
    "licenses",
    "THIRD_PARTY_NOTICES.md",
    "vendor/omp/PROVENANCE.md",
    "README.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "check": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "optionalDependencies": {
    "@sheethappiness/pi-ghost-autocomplete-darwin-arm64": "0.1.0",
    "@sheethappiness/pi-ghost-autocomplete-linux-arm64-gnu": "0.1.0",
    "@sheethappiness/pi-ghost-autocomplete-linux-x64-gnu": "0.1.0",
    "@sheethappiness/pi-ghost-autocomplete-win32-x64-msvc": "0.1.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@types/node": "22.19.19",
    "prettier": "3.6.2",
    "typescript": "7.0.2"
  }
}
